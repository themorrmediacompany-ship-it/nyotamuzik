{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/brand-system",
      "destination": "/system"
    },
    {
      "source": "/events/:slug",
      "destination": "/api/seo?p=event&slug=:slug"
    },
    {
      "source": "/austin/this-weekend",
      "destination": "/api/seo?p=weekend"
    },
    {
      "source": "/austin",
      "destination": "/api/seo?p=list"
    },
    {
      "source": "/austin/:cat",
      "destination": "/api/seo?p=list&cat=:cat"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?p=sitemap"
    },
    {
      "source": "/how-it-works",
      "destination": "/api/seo?p=trust&page=how-it-works"
    },
    {
      "source": "/privacy",
      "destination": "/api/seo?p=trust&page=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/seo?p=trust&page=terms"
    },
    {
      "source": "/contact",
      "destination": "/api/seo?p=trust&page=contact"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/engine/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(system|admin|direction)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/read-link.js": {
      "maxDuration": 10
    },
    "api/discover.js": {
      "maxDuration": 60
    },
    "api/events.js": {
      "maxDuration": 10
    },
    "api/seo.js": {
      "maxDuration": 10,
      "includeFiles": "{engine,lib}/**"
    },
    "api/report.js": {
      "maxDuration": 10
    },
    "api/status.js": {
      "maxDuration": 10
    }
  },
  "images": {
    "sizes": [
      320,
      480,
      640,
      960,
      1280,
      1600,
      1920
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 86400,
    "localPatterns": [
      {
        "pathname": "^/(assets|brand)/.*"
      }
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "upload.wikimedia.org"
      }
    ]
  },
  "crons": [
    {
      "path": "/api/discover",
      "schedule": "0 11 * * *"
    }
  ]
}
